{
  "name": "nuevo-estilo-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static website checks and safety rails for Gimnasio Nuevo Estilo.",
  "scripts": {
    "check": "npm run check:html && npm run check:protected-content",
    "check:html": "node scripts/check-html.mjs",
    "check:protected-content": "node scripts/check-protected-content.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "security:setup": "node scripts/install-gitleaks.mjs",
    "secrets:scan": ".tools/gitleaks/current/gitleaks git --redact --no-banner .",
    "secrets:scan:staged": ".tools/gitleaks/current/gitleaks git --staged --redact --no-banner .",
    "audit:deps": "audit-ci --config ./audit-ci.jsonc",
    "commitlint": "commitlint --from HEAD~1 --to HEAD"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.29.0",
    "audit-ci": "^7.1.0",
    "eslint": "^9.29.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4"
  }
}
